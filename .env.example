# API (server/index.mjs)
PORT=8787
HOST=127.0.0.1
# Persistent directory for the SQLite database
DATA_DIR=./server/data
# Admin moderation token: at least 24 random characters, e.g. `openssl rand -hex 24`. Admin is disabled if unset.
ADMIN_TOKEN=
# Web origins allowed to call the API, comma separated (or *)
ALLOWED_ORIGINS=http://localhost:8443
# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# Frontend build: public API origin, e.g. https://api.example.com (empty = same origin)
VITE_API_URL=
