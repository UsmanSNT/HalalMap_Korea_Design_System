# Neon PostgreSQL ulanish satri (faqat server tomonida ishlatiladi)
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-2.aws.neon.tech/halalmap?sslmode=require

# API server porti (default: 8787)
API_PORT=8787

# ─────────────────────────────────────────────────────────────────────────────
# Product Scanner (docs/product-scanner.md, docs/data-sources.md)
# Secrets go here (.env is git-ignored) — never in source code.
# ─────────────────────────────────────────────────────────────────────────────

# SQLite location (defaults to server/data/halalmap.sqlite). Uploaded photos live next to it in uploads/.
# HALALMAP_DATA_DIR=./server/data
# HALALMAP_DB_PATH=./server/data/halalmap.sqlite

# Local test accounts (admin@halalmap.test / Admin123! …) are seeded unless NODE_ENV=production.
# In production leave this unset (no default admin) or set it to 1 only for a demo deployment.
# HALALMAP_SEED_TEST_USERS=0

# Set to 1 when running behind a reverse proxy so rate limits use X-Forwarded-For.
# TRUST_PROXY=1

# ── Food Safety Korea (식약처/MFDS) Open API — free key ───────────────────────
# Register at https://www.foodsafetykorea.go.kr/api/ , copy the 인증키 here.
# Services used: C005 (barcode -> product) and C002 (raw materials, 원재료명).
# Without the key the lookup simply skips MFDS and uses Open Food Facts.
# FOODSAFETYKOREA_API_KEY=
# The licence/terms of this source are marked "unconfirmed" in the registry. After reading
# https://www.foodsafetykorea.go.kr/api/openApiInfo.do set this to 1 to acknowledge them:
# FOODSAFETYKOREA_ACCEPT_TERMS=0
# FOODSAFETYKOREA_BASE_URL=https://openapi.foodsafetykorea.go.kr/api
# MFDS_MAX_PER_MINUTE=30
# MFDS_MAX_PER_DAY=1000

# ── Open Food Facts (no key) ──────────────────────────────────────────────────
# Identify your deployment (OFF requires a custom User-Agent: app name/version + contact).
# OFF_USER_AGENT=HalalMapKorea/1.0 (https://your-domain.example, contact@your-domain.example)
# OFF_DISABLED=0
# OFF_MAX_PER_MINUTE=60

# ── Place importers (no key) ──────────────────────────────────────────────────
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# OVERPASS_USER_AGENT=HalalMapKorea/1.0 (contact@your-domain.example)
# WIKIDATA_USER_AGENT=HalalMapKorea/1.0 (contact@your-domain.example)

# ── Optional server-side OCR for ingredient-label photos ──────────────────────
# Default is on-device OCR (Tesseract.js, no key, nothing leaves the phone). Set ONE of these for higher accuracy;
# the photo is then sent to your server and on to the provider.
# GOOGLE_VISION_API_KEY=
# CLOVA_OCR_INVOKE_URL=
# CLOVA_OCR_SECRET=
