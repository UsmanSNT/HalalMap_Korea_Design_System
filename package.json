{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "node --no-warnings --test server/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "import:places": "node scripts/import-places.mjs",
    "import:products": "node scripts/import-products.mjs",
    "import:ingredients": "node scripts/import-ingredients.mjs",
    "mfds:probe": "node scripts/mfds-probe.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@zxing/library": "^0.23.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
