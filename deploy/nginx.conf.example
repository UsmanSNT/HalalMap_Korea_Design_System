# /etc/nginx/sites-available/avrangzeb.uz  (TLS via certbot; HTTPS is required for geolocation and compass)
server {
    listen 80;
    server_name avrangzeb.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name avrangzeb.uz;
    ssl_certificate     /etc/letsencrypt/live/avrangzeb.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/avrangzeb.uz/privkey.pem;

    client_max_body_size 16k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never append: the API trusts it for rate limiting
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
